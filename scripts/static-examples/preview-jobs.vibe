class JobsPreview
  type Payload = { player_id: string }
  type Receipt = { status: string, job: string, player_id: string, delay: string, key: string }

  def enqueue(name: string, payload: Payload, *, delay: duration, key: string) -> Receipt
    { status: "preview", job: name, player_id: payload["player_id"], delay: delay.to_s, key: key }
  end
end

def jobs -> JobsPreview
  JobsPreview.new
end
