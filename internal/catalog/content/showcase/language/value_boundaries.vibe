# title: Value boundaries
# category: Vibescript Showcase
# difficulty: Showcase
# summary: Update arrays and hashes without changing the values held by aliases.
# description: Collections behave as values, and hash keys are strings.
# tags: language, collections, hashes, values
# featured: true
# feature_rank: -1
# vibe: 0.1.0

type Order = { id: string, status: string }

type OrderChange = { original: Order, updated: Order, string_lookup: string }

type QueueChange = { original: array<string>, updated: array<string> }

type Changes = { order: OrderChange, reviews: QueueChange }

def with_status(order: Order, status: string) -> OrderChange
  original = order
  order["status"] = status

  {
    original: original,
    updated: order,
    string_lookup: order["status"]
  }
end

def append_review(
  queue: array<string>,
  review: string
) -> QueueChange
  original = queue
  queue << review

  {
    original: original,
    updated: queue
  }
end

def run -> Changes
  {
    order: with_status({ id: "o-17", status: "new" }, "approved"),
    reviews: append_review(["security"], "finance")
  }
end
