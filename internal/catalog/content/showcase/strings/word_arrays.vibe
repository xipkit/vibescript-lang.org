# title: Word and symbol arrays
# category: Vibescript Showcase
# difficulty: Showcase
# summary: Build explicit string and symbol arrays, with interpolation for generated names.
# description: Array literals show each element and its type. Strings can interpolate values when building names.
# tags: strings, symbols, literals
# vibe: 0.1.0

type WordArrays = {
  static_tags: array<string>,
  build_targets: array<string>,
  lifecycle_states: array<string>,
  first_state: string,
  target_count: int
}

def static_tags -> array<string>
  ["alpha", "beta", "gamma"]
end

def build_targets(env: string) -> array<string>
  ["build-#{env}", "deploy-#{env}", "verify-#{env}"]
end

def lifecycle_states -> array<symbol>
  [:queued, :running, :done]
end

def run -> WordArrays
  {
    static_tags: static_tags,
    build_targets: build_targets("prod"),
    lifecycle_states: lifecycle_states.map { |state| state.to_s },
    first_state: lifecycle_states[0].to_s,
    target_count: build_targets("staging").length
  }
end
