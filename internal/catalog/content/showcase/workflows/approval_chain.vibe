# title: Approval chain
# category: Vibescript Showcase
# difficulty: Showcase
# summary: Build a release approval process with states and deadlines.
# description: Enums name each state, durations set deadlines, and the result lists each review step.
# tags: workflows, durations, enums, approvals
# vibe: 0.1.0

type ApprovalStep = { label: string, due_in: string, due_at: string }

type ApprovalChain = {
  change_id: string,
  state: string,
  next_state: string,
  checks_passed: bool,
  steps: array<ApprovalStep>
}

type ApprovalChains = { pending: ApprovalChain, ready: ApprovalChain }

enum ApprovalState
  Draft
  Review
  Approved
  Blocked
end

def next_state(state: ApprovalState, checks_passed: bool) -> ApprovalState
  if state == ApprovalState::Draft
    ApprovalState::Review
  elsif state == ApprovalState::Review && checks_passed
    ApprovalState::Approved
  elsif state == ApprovalState::Review
    ApprovalState::Blocked
  else
    state
  end
end

def approval_step(
  label: string,
  due_in: duration,
  opened_at: time
) -> ApprovalStep
  {
    label: label,
    due_in: due_in.iso8601,
    due_at: due_in.after(opened_at).format("2006-01-02T15:04:05Z")
  }
end

def approval_chain(
  change_id: string,
  state: ApprovalState,
  checks_passed: bool,
  opened_at: time
) -> ApprovalChain
  target_state = next_state(state, checks_passed)
  steps: array<ApprovalStep> = []

  if state == ApprovalState::Draft
    steps.push(approval_step("peer review", 2.hours, opened_at))
  elsif state == ApprovalState::Review
    steps.push(approval_step("security review", 4.hours, opened_at))
    steps.push(approval_step("ops signoff", 8.hours, opened_at))
  else
    steps.push(approval_step("release", 30.minutes, opened_at))
  end

  {
    change_id: change_id,
    state: state.name,
    next_state: target_state.name,
    checks_passed: checks_passed,
    steps: steps
  }
end

def run -> ApprovalChains
  opened_at = Time.at(1701000000)

  {
    pending: approval_chain("change_88", ApprovalState::Review, false, opened_at),
    ready: approval_chain("change_89", ApprovalState::Review, true, opened_at)
  }
end
