# title: Send an SMS
# category: Vibescript Showcase
# difficulty: Embedding
# summary: Write a delivery update and send it through a host SMS capability.
# description: The preview adapter returns a message preview. No SMS is sent.
# tags: notifications, capabilities, sms, embedding
# featured: true
# feature_rank: -3
# uses: sms
# vibe: 0.1.0

def delivery_update(phone: string, order_id: string) -> { body: string, status: string, to: string }
  body = "Order #{order_id} is on its way."
  sms.send(phone, body)
end

def run -> { body: string, status: string, to: string }
  delivery_update("+12025550123", "1042")
end
