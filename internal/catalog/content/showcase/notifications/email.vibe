# title: Send an email
# category: Vibescript Showcase
# difficulty: Embedding
# summary: Build a welcome email and send it through a host email capability.
# description: The preview adapter returns a message preview. No email is sent.
# tags: notifications, capabilities, email, embedding
# featured: true
# feature_rank: -2
# uses: email
# vibe: 0.1.0

def welcome(
  address: string,
  name: string
) -> { body: string, status: string, subject: string, to: string }
  subject = "Welcome, #{name}!"
  body = "Hi #{name},\n\nYour account is ready. Thanks for joining us."
  email.send(address, subject, body)
end

def run -> { body: string, status: string, subject: string, to: string }
  welcome("alex@example.com", "Alex")
end
