# title: Rot-13
# source: https://rosettacode.org/wiki/Rot-13
# category: Rosetta Code
# difficulty: Intro
# summary: Encode and decode text by rotating letters by thirteen positions.
# tags: popular, strings, crypto, substitution
# vibe: 0.1.0

def rotate_index(index: int, shift: int) -> int
  rotated = index + shift

  while rotated >= 26
    rotated = rotated - 26
  end

  while rotated < 0
    rotated = rotated + 26
  end

  rotated
end

def rotate_char(char: string, shift: int) -> string
  upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  lower = "abcdefghijklmnopqrstuvwxyz"

  upper_index = upper.index(char)
  if upper_index != nil
    return upper.chars.fetch(rotate_index(upper_index, shift))
  end

  lower_index = lower.index(char)
  if lower_index != nil
    return lower.chars.fetch(rotate_index(lower_index, shift))
  end

  char
end

def rot13(text: string) -> string
  text_chars = text.chars
  output = ""
  index = 0

  while index < text.length
    output = output + rotate_char(text_chars.fetch(index), 13)
    index = index + 1
  end

  output
end

def run -> { decoded: string, encoded: string, plain: string }
  plain = "Vibescript keeps Rosetta examples runnable."
  encoded = rot13(plain)
  {
    plain: plain,
    encoded: encoded,
    decoded: rot13(encoded)
  }
end
