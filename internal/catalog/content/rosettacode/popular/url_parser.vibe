# title: URL parser
# source: https://rosettacode.org/wiki/URL_parser
# category: Rosetta Code
# difficulty: Intro
# summary: Parse a fixed URL into scheme, host, path, and query parameters.
# tags: popular, strings, parsing, hashes
# vibe: 0.1.0

type QueryParam = { key: string, value: string }
type Url = { scheme: string, host: string, path: string, query: array<QueryParam> }

def parse_query(text: string) -> array<QueryParam>
  if text == ""
    return []
  end

  parts = text.split("&")
  output: array<QueryParam> = []
  index = 0

  while index < parts.length
    entry = parts.fetch(index).split("=")
    output.push({
      key: entry.fetch(0),
      value: entry.fetch(1)
    })
    index = index + 1
  end

  output
end

def parse_url(url: string) -> Url
  scheme, separator, remainder = url.partition("://")
  raise ArgumentError, "expected a URL scheme" if separator == ""
  host, slash, path_and_query = remainder.partition("/")
  path, question, query = path_and_query.partition("?")
  {
    scheme: scheme,
    host: host,
    path: slash + path,
    query: parse_query(query)
  }
end

def run -> Url
  parse_url("https://example.com/docs/guide?page=2&lang=en")
end
