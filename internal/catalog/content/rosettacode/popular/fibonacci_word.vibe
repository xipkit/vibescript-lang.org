# title: Fibonacci word
# source: https://rosettacode.org/wiki/Fibonacci_word
# category: Rosetta Code
# difficulty: Intro
# summary: Build the opening Fibonacci words by concatenating the two previous terms.
# tags: popular, strings, sequences, recursion
# vibe: 0.1.0

type FibonacciWords = { words: array<string>, final_length: int }

def fibonacci_words(count: int) -> array<string>
  words: array<string> = []
  previous = "1"
  current = "0"
  index = 0

  while index < count
    words.push(current)
    next_word = current + previous
    previous = current
    current = next_word
    index = index + 1
  end

  words
end

def run -> FibonacciWords
  words = fibonacci_words(8)
  {
    words: words,
    final_length: words.fetch(words.length - 1).length
  }
end
