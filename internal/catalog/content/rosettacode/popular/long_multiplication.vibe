# title: Long multiplication
# source: https://rosettacode.org/wiki/Long_multiplication
# category: Rosetta Code
# difficulty: Intro
# summary: Break a multiplication problem into the partial products used by long multiplication.
# tags: popular, math, formatting, digits
# vibe: 0.1.0

type Multiplication = { multiplicand: int, multiplier: int, partials: array<int>, product: int }

def digit_value(char: string) -> int
  digit = "0123456789".index(char)
  raise ArgumentError, "expected a decimal digit" if digit == nil
  digit
end

def power_of_ten(exponent: int) -> int
  value = 1
  count = 0

  while count < exponent
    value = value * 10
    count = count + 1
  end

  value
end

def partial_products(multiplicand: int, multiplier: int) -> array<int>
  digits = multiplier.to_s
  products: array<int> = []
  shift = 0
  index = digits.length - 1

  while index >= 0
    products.push(multiplicand * digit_value(digits.chars.fetch(index)) * power_of_ten(shift))
    shift = shift + 1
    index = index - 1
  end

  products
end

def run -> Multiplication
  multiplicand = 123
  multiplier = 45
  {
    multiplicand: multiplicand,
    multiplier: multiplier,
    partials: partial_products(multiplicand, multiplier),
    product: multiplicand * multiplier
  }
end
