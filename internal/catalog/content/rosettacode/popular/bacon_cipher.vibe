# title: Bacon cipher
# source: https://rosettacode.org/wiki/Bacon_cipher
# category: Rosetta Code
# difficulty: Medium
# summary: Encode and decode short messages with Bacon's five-letter A/B cipher.
# tags: popular, strings, ciphers, encoding
# vibe: 0.1.0

def alphabet -> string
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
end

def digit_to_ab(value: int) -> string
  if value == 0
    "A"
  else
    "B"
  end
end

def bacon_code(index: int) -> string
  digits = ""
  current = index
  count = 0

  while count < 5
    digits = digit_to_ab(current % 2) + digits
    current = current // 2
    count = count + 1
  end

  digits
end

def encode(text: string) -> string
  text_chars = text.chars
  output: array<string> = []
  index = 0

  while index < text.length
    char = text_chars.fetch(index).upcase
    if char == " "
      output.push("/")
    else
      letter_index = alphabet.index(char)
      raise ArgumentError, "expected an uppercase letter" if letter_index == nil
      output.push(bacon_code(letter_index))
    end
    index = index + 1
  end

  output.join(" ")
end

def decode(text: string) -> string
  parts = text.split(" ")
  output = ""
  index = 0

  while index < parts.length
    part = parts.fetch(index)
    if part == "/"
      output = output + " "
    else
      letter_index = 0
      while letter_index < alphabet.length
        if bacon_code(letter_index) == part
          output = output + alphabet.chars.fetch(letter_index)
          break
        end
        letter_index = letter_index + 1
      end
    end
    index = index + 1
  end

  output
end

def run -> hash<string, string>
  encoded = encode("VIBE CODE")
  {
    encoded: encoded,
    decoded: decode(encoded)
  }
end
