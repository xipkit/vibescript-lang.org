# title: Natural sorting
# source: https://rosettacode.org/wiki/Natural_sorting
# category: Rosetta Code
# difficulty: Medium
# summary: Sort filenames by comparing embedded digit runs numerically instead of lexicographically.
# tags: popular, strings, sorting, parsing
# vibe: 0.1.0

type ParsedNumber = { value: int, next_index: int }

def digit?(char: string) -> bool
  char >= "0" && char <= "9"
end

def digit_value(char: string) -> int
  digit = "0123456789".index(char)
  raise ArgumentError, "expected a decimal digit" if digit == nil
  digit
end

def read_number(text: string, start_index: int) -> ParsedNumber
  text_chars = text.chars
  value = 0
  index = start_index

  while index < text.length && digit?(text_chars.fetch(index))
    value = (value * 10) + digit_value(text_chars.fetch(index))
    index = index + 1
  end

  {
    value: value,
    next_index: index
  }
end

def natural_compare(left: string, right: string) -> int
  left_chars = left.chars
  right_chars = right.chars
  left_index = 0
  right_index = 0

  while left_index < left.length && right_index < right.length
    left_char = left_chars.fetch(left_index)
    right_char = right_chars.fetch(right_index)

    if digit?(left_char) && digit?(right_char)
      left_number = read_number(left, left_index)
      right_number = read_number(right, right_index)
      if left_number["value"] != right_number["value"]
        return left_number["value"] - right_number["value"]
      end
      left_index = left_number["next_index"]
      right_index = right_number["next_index"]
    else
      if left_char < right_char
        return -1
      elsif left_char > right_char
        return 1
      end
      left_index = left_index + 1
      right_index = right_index + 1
    end
  end

  if left.length < right.length
    -1
  elsif left.length > right.length
    1
  else
    0
  end
end

def natural_sort(values: array<string>) -> array<string>
  values.sort { |left, right|
    natural_compare(left, right)
  }
end

def run -> array<string>
  natural_sort(["file2.txt", "file10.txt", "file1.txt", "file20.txt", "file3.txt"])
end
