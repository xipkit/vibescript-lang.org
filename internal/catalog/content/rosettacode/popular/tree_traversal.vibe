# title: Tree traversal
# source: https://rosettacode.org/wiki/Tree_traversal
# category: Rosetta Code
# difficulty: Medium
# summary: Traverse a small binary tree in preorder, inorder, postorder, and level order.
# tags: popular, trees, recursion, data-structures
# vibe: 0.1.0

type RunResult = {
  preorder: array<string>,
  inorder: array<string>,
  postorder: array<string>,
  level_order: array<string>
}

class Node
  getter value: string
  getter left: Node?
  getter right: Node?

  def initialize(@value: string, @left: Node? = nil, @right: Node? = nil)
  end
end

def sample_tree -> Node
  Node.new("F",
    Node.new("B", Node.new("A"), Node.new("D", Node.new("C"), Node.new("E"))),
    Node.new("G", nil, Node.new("I", Node.new("H"))))
end

def preorder(node: Node?) -> array<string>
  return [] if node == nil
  [node.value] + preorder(node.left) + preorder(node.right)
end

def inorder(node: Node?) -> array<string>
  return [] if node == nil
  inorder(node.left) + [node.value] + inorder(node.right)
end

def postorder(node: Node?) -> array<string>
  return [] if node == nil
  postorder(node.left) + postorder(node.right) + [node.value]
end

def level_order(root: Node?) -> array<string>
  return [] if root == nil
  queue = [root]
  output: array<string> = []
  index = 0
  while index < queue.length
    current = queue.fetch(index)
    output << current.value
    left = current.left
    right = current.right
    queue << left if left != nil
    queue << right if right != nil
    index += 1
  end
  output
end

def run -> RunResult
  tree = sample_tree
  {
    preorder: preorder(tree),
    inorder: inorder(tree),
    postorder: postorder(tree),
    level_order: level_order(tree)
  }
end
