# title: Run-length encoding
# source: https://rosettacode.org/wiki/Run-length_encoding
# category: Rosetta Code
# difficulty: Easy
# summary: Encode and decode a short sample string with classic run-length encoding.
# tags: popular, strings, compression, loops
# vibe: 0.1.0

type CharRun = { char: string, count: int }
type RoundTrip = { sample: string, encoded: array<CharRun>, decoded: string }

def encode(text: string) -> array<CharRun>
  if text == ""
    return []
  end

  output: array<CharRun> = []
  current = text.chars.fetch(0)
  count = 1
  index = 1

  while index < text.length
    char = text.chars.fetch(index)

    if char == current
      count = count + 1
    else
      output.push({
        char: current,
        count: count
      })
      current = char
      count = 1
    end

    index = index + 1
  end

  output.push({
    char: current,
    count: count
  })
end

def decode(runs: array<CharRun>) -> string
  output = ""
  index = 0

  while index < runs.length
    entry = runs.fetch(index)
    entry["count"].times {
      output = output + entry["char"]
    }

    index = index + 1
  end

  output
end

def run -> RoundTrip
  sample = "AAABBCCCC"
  encoded = encode(sample)
  {
    sample: sample,
    encoded: encoded,
    decoded: decode(encoded)
  }
end
