# title: String matching
# source: https://rosettacode.org/wiki/String_matching
# category: Rosetta Code
# difficulty: Intro
# summary: Find every starting index of a pattern inside a fixed string with a naive scan.
# tags: popular, strings, search, loops
# vibe: 0.1.0

def matches_at?(text: string, pattern: string, start_index: int) -> bool
  text_chars = text.chars
  pattern_chars = pattern.chars
  offset = 0

  while offset < pattern.length
    if text_chars.fetch(start_index + offset) != pattern_chars.fetch(offset)
      return false
    end
    offset = offset + 1
  end

  true
end

def string_matching(text: string, pattern: string) -> array<int>
  matches: array<int> = []
  index = 0

  while index + pattern.length <= text.length
    if matches_at?(text, pattern, index)
      matches.push(index)
    end
    index = index + 1
  end

  matches
end

def run -> hash<string, array<int>>
  {
    aba_in_ababa: string_matching("ababa", "aba"),
    ana_in_bananas: string_matching("bananas", "ana")
  }
end
