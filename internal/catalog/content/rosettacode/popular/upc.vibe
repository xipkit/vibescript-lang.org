# title: UPC
# source: https://rosettacode.org/wiki/UPC
# category: Rosetta Code
# difficulty: Intro
# summary: Validate sample UPC codes with the standard checksum rule.
# tags: popular, strings, validation, checksum
# vibe: 0.1.0

type UpcCheck = { code: string, valid: bool }

def digit_value(char: string) -> int
  digit = "0123456789".index(char)
  raise ArgumentError, "expected a decimal digit" if digit == nil
  digit
end

def valid_upc?(code: string) -> bool
  code_chars = code.chars
  sum = 0
  index = 0

  while index < code.length
    digit = digit_value(code_chars.fetch(index))
    if index.even?
      sum = sum + (digit * 3)
    else
      sum = sum + digit
    end
    index = index + 1
  end

  sum % 10 == 0
end

def run -> array<UpcCheck>
  [
    { code: "036000291452", valid: valid_upc?("036000291452") },
    { code: "042100005264", valid: valid_upc?("042100005264") },
    { code: "123456789999", valid: valid_upc?("123456789999") }
  ]
end
