# title: Leap year
# source: https://rosettacode.org/wiki/Leap_year
# category: Rosetta Code
# difficulty: Intro
# summary: Determine whether a given year is a leap year using the Gregorian calendar rules.
# tags: popular, math, conditionals, basics
# vibe: 0.1.0

type YearCheck = { year: int, leap: bool }

def leap_year?(year: int) -> bool
  if year % 400 == 0
    return true
  elsif year % 100 == 0
    return false
  elsif year % 4 == 0
    return true
  end
  false
end

def run -> array<YearCheck>
  years = [1900, 2000, 1996, 1997, 2024, 2025, 2100, 2400]
  results: array<YearCheck> = []
  i = 0
  while i < years.length
    results.push({ year: years.fetch(i), leap: leap_year?(years.fetch(i)) })
    i = i + 1
  end
  results
end
