# title: Pig Latin
# source: https://rosettacode.org/wiki/Pig_Latin
# category: Rosetta Code
# difficulty: Easy
# summary: Translate English words into Pig Latin by moving leading consonants and appending ay.
# tags: popular, strings, transformation
# vibe: 0.1.0

def is_vowel(char: string) -> bool
  vowels = "aeiouAEIOU"
  vowels.index(char) != nil
end

def pig_word(word: string) -> string
  word_chars = word.chars
  if word.length == 0
    return ""
  end

  if is_vowel(word_chars.fetch(0))
    return word + "ay"
  end

  i = 0
  while i < word.length
    if is_vowel(word_chars.fetch(i))
      consonants = ""
      j = 0
      while j < i
        consonants = consonants + word_chars.fetch(j)
        j = j + 1
      end
      rest = ""
      j = i
      while j < word.length
        rest = rest + word_chars.fetch(j)
        j = j + 1
      end
      return rest + consonants + "ay"
    end
    i = i + 1
  end

  word + "ay"
end

def pig_latin(sentence: string) -> string
  words = sentence.split(" ")
  translated: array<string> = []
  i = 0
  while i < words.length
    translated.push(pig_word(words.fetch(i)))
    i = i + 1
  end
  translated.join(" ")
end

def run -> hash<string, string>
  {
    hello: pig_word("hello"),
    world: pig_word("world"),
    apple: pig_word("apple"),
    string: pig_word("string"),
    sentence: pig_latin("hi there")
  }
end
