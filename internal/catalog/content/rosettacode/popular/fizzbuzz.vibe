# title: FizzBuzz
# source: https://rosettacode.org/wiki/FizzBuzz
# category: Rosetta Code
# difficulty: Intro
# summary: Emit the classic FizzBuzz sequence up to a chosen limit.
# tags: popular, loops, strings, basics
# vibe: 0.1.0

def fizzbuzz(limit: int) -> array<string>
  lines: array<string> = []
  for value in 1..limit
    if value % 15 == 0
      lines.push("FizzBuzz")
    elsif value % 3 == 0
      lines.push("Fizz")
    elsif value % 5 == 0
      lines.push("Buzz")
    else
      lines.push(value.to_s)
    end
  end
  lines
end

def run -> array<string>
  fizzbuzz(30)
end
