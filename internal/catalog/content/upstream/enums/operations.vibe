# vibe: 0.1.0
# Enum basics

type FactsResult = {
  cross_enum_same: bool,
  name: string,
  payload: string,
  render: string,
  same: bool,
  symbol: symbol,
  symbol_same: bool
}

type RunResult = {
  facts: FactsResult,
  member_name: string,
  names: array<string>,
  published_name: string
}

enum Status
  Draft
  Published
  Archived
end

enum ReviewState
  Draft
  Approved
end

def member_name -> string
  Status::Draft.name
end

def publish_name(status: Status) -> string
  status.name
end

def block_names(values: array<Status>) -> array<string>
  values.map { |status: Status|
    status.name
  }
end

def facts -> FactsResult
  draft = Status::Draft
  draft_symbol = :draft

  {
    same: draft == Status::Draft,
    symbol_same: draft == draft_symbol,
    cross_enum_same: draft == ReviewState::Draft,
    name: draft.name,
    symbol: draft.symbol,
    render: "status={{value}}".template({ value: draft }),
    payload: JSON.stringify({ status: draft })
  }
end

def run -> RunResult
  {
    member_name: member_name,
    published_name: publish_name(:published),
    names: block_names([Status::Draft, Status::Published]),
    facts: facts
  }
end
