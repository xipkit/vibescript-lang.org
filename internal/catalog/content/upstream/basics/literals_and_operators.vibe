# vibe: 0.1.0

type Literals = { answer: int, ratio: float, quote: string, flags: array<bool | nil> }

type Operations = {
  add: int,
  combine: string,
  negate: int,
  truth: bool,
  literals: Literals
}

def add_numbers(a: int, b: int) -> int
  a + b
end

def combine_strings(first: string, second: string) -> string
  first + " " + second
end

def negate(value: int) -> int
  -value
end

def truth_table(flag: bool) -> bool
  if flag
    true
  else
    false
  end
end

def mix_literals -> Literals
  {
    answer: 42,
    ratio: 3.75,
    quote: "keep going",
    flags: [true, false, nil]
  }
end

def run -> Operations
  {
    add: add_numbers(10, 25),
    combine: combine_strings("hello", "world"),
    negate: negate(7),
    truth: truth_table(true),
    literals: mix_literals
  }
end
