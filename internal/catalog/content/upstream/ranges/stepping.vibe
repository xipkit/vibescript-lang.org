# title: Step through ranges
# summary: Walk ranges in steps, test membership, and clamp values into bounds.
# vibe: 0.1.0

def every(range: range, by: int) -> array<int>
  values: array<int> = []
  range.step(by) { |value| values << value }
  values
end

type RunResult = {
  every_fifth: array<int>,
  countdown: array<int>,
  business_hours: array<bool>,
  clamped: array<int>,
  lengths: { inclusive: int, exclusive: int },
  sum_of_squares: int
}

def run -> RunResult
  hours = 9...17

  {
    every_fifth: every(0..30, 5),
    countdown: every(1..10, 3).reverse,
    business_hours: [8, 9, 16, 17].map { |hour| hours.include?(hour) },
    clamped: [-5, 42, 180].map { |percent| percent.clamp(0..100) },
    lengths: { inclusive: (1..5).length, exclusive: (1...5).length },
    sum_of_squares: (1..10).reduce(0) { |total, n| total + n * n }
  }
end
