# vibe: 0.1.0

type KeyView = { same_entry: bool, keys: array<string> }
type SymbolKeys = { keys: array<symbol>, fetched: string, normalized: KeyView }

def permission_keys -> array<symbol>
  [:read, :write, :delete]
end

def fetch_hash_key(record: hash<string, string>, key: symbol) -> string
  record.fetch(key.to_s)
end

def normalized_hash_view(record: hash<string, string>) -> KeyView
  name_key = :name
  {
    same_entry: record.fetch(name_key.to_s) == record.fetch("name"),
    keys: record.keys
  }
end

def run -> SymbolKeys
  record = { name: "Alice", role: "coach" }
  {
    keys: permission_keys,
    fetched: fetch_hash_key(record, :name),
    normalized: normalized_hash_view(record)
  }
end
