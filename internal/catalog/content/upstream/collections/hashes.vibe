# vibe: 0.1.0

type Player = { name: string, goal: int, raised: int, status: string }
type Row = { raised: int }
type Meta = { tag: string }
type Tagged = { meta: Meta }

type HashLookups = {
  player: Player,
  completed: Player,
  with_bonus: int,
  nested: string
}

def make_player(name: string, goal: int) -> Player
  {
    name: name,
    goal: goal,
    raised: 0,
    status: "active"
  }
end

def mark_complete(player: Player) -> Player
  player["status"] = "complete"
  player
end

def total_with_bonus(row: Row, bonus: int) -> int
  row["raised"] + bonus
end

def nested_lookup(record: Tagged) -> string
  record["meta"]["tag"]
end

def run -> HashLookups
  player = make_player("Alice", 1000)
  completed = mark_complete(make_player("Bob", 500))
  {
    player: player,
    completed: completed,
    with_bonus: total_with_bonus({ raised: 250 }, 50),
    nested: nested_lookup({ meta: { tag: "vip" } })
  }
end
