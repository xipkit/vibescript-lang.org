# title: Total payments by currency
# summary: Group payments by currency and total each group, since money only adds within one currency.
# vibe: 0.1.0

type Payment = { customer: string, amount: money }

def totals_by_currency(payments: array<Payment>) -> hash<string, money>
  payments
    .group_by { |payment| payment["amount"].currency }
    .transform_values { |group|
      first = group.fetch(0)["amount"]
      group.drop(1).reduce(first) { |total, payment| total + payment["amount"] }
    }
end

def largest(payments: array<Payment>, currency: string) -> string
  top = payments
    .select { |payment| payment["amount"].currency == currency }
    .max_by { |payment| payment["amount"] }
  top == nil ? "none" : "#{top["customer"]} (#{top["amount"]})"
end

type RunResult = {
  totals: hash<string, money>,
  largest_usd: string,
  largest_eur: string,
  refundable: bool
}

def run -> RunResult
  payments: array<Payment> = [
    { customer: "Ada", amount: money("120.00 USD") },
    { customer: "Lin", amount: money("45.50 EUR") },
    { customer: "Kai", amount: money("80.25 USD") },
    { customer: "Mae", amount: money("19.99 EUR") },
    { customer: "Sol", amount: money("64.00 GBP") }
  ]

  {
    totals: totals_by_currency(payments),
    largest_usd: largest(payments, "USD"),
    largest_eur: largest(payments, "EUR"),
    refundable: money("45.50 EUR").between?(money("0.01 EUR"), money("50.00 EUR"))
  }
end
