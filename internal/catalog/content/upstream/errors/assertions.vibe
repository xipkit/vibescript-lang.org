# vibe: 0.1.0

type Checked = { positive: int, currency: money, present: string }

def ensure_positive(amount: int) -> int
  assert amount > 0, "amount must be positive"
  amount
end

def ensure_currency(pledge: money) -> money
  assert pledge.currency == "USD", "only USD pledges supported"
  pledge
end

def guard_present(value: string?) -> string
  raise AssertionError, "value must be present" if value == nil
  value
end

def run -> Checked
  {
    positive: ensure_positive(42),
    currency: ensure_currency(money("25.00 USD")),
    present: guard_present("hello")
  }
end
