# vibe: 0.1.0

type Delays = { reminder_delay: int, event_window: duration, combined: int }

def reminder_delay_seconds -> int
  (5.minutes).to_i
end

def event_window -> duration
  2.hours
end

def combine_delay_seconds(first: duration, second: duration) -> int
  first.to_i + second.to_i
end

def run -> Delays
  {
    reminder_delay: reminder_delay_seconds,
    event_window: event_window,
    combined: combine_delay_seconds(5.minutes, 10.minutes)
  }
end
