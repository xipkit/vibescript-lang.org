# vibe: 0.1.0
# uses: db

type HostNote = { note: string, functions: array<string> }

def total_raised_for_player(player_id: string) -> money
  total = money("0.00 USD")
  db.each("ScoreEntry", where: { player_id: player_id }) { |entry|
    total = total + entry["amount"]
  }
  total
end

def run -> HostNote
  {
    note: "This example requires the db capability which is injected by the host application.",
    functions: ["total_raised_for_player"]
  }
end
