# vibe: 0.1.0
# uses: jobs, events, db
# The host owns the queue and performs delayed work after this call returns.

type Player = { id: string, raised: money }
type RecalcPayload = { player_id: string }
type QueuedJob = { status: string, job: string, player_id: string, delay: string, key: string }
type TotalUpdate = { id: string, total: string }
type PublishedEvent = { status: string, channel: string, payload: TotalUpdate }
type HostNote = { note: string, functions: array<string> }

def queue_recalc(player_id: string) -> QueuedJob
  jobs.enqueue(
    "recalc_player_total",
    { player_id: player_id },
    delay: 2.seconds,
    key: "recalc:" + player_id
  )
end

def publish_update(player: Player) -> PublishedEvent
  events.publish(
    "players_totals",
    {
      id: player["id"],
      total: player["raised"].to_s
    }
  )
end

def job_recalc_player_total(payload: RecalcPayload) -> PublishedEvent
  player_id = payload["player_id"]
  total = db.sum("ScoreEntry", "amount", where: { player_id: player_id })
  db.update("Player", player_id, { raised: total })
  publish_update({ id: player_id, raised: total })
end

def run -> HostNote
  {
    note: "This example requires jobs, events, and db capabilities which are injected by the host application.",
    functions: ["queue_recalc", "publish_update", "job_recalc_player_total"]
  }
end
